{
  "schemaVersion": 1,
  "id": "fazuh.screenlogs",
  "name": "Screenlogs",
  "version": "1.1.0",
  "author": "FAZuH",
  "license": "MIT",
  "description": "Periodic screen capture: a fullscreen screenshot every N seconds, per monitor, with lock/idle/active-hours pauses and count, age and disk-budget retention.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Screenlogs",
    "description": "Periodic screen capture with lock/idle pauses and count, age and disk retention",
    "category": "Capture",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "periodSec": 60,
      "dir": "~/Pictures/screenlogs",
      "monitors": [],
      "pauseWhenLocked": true,
      "activeFrom": "",
      "activeTo": "",
      "idleMinutes": 0,
      "format": "png",
      "jpegQuality": 85,
      "keep": 500,
      "keepHours": 0,
      "maxDiskMb": 0
    },
    "schema": [
      {
        "key": "enabled",
        "type": "boolean",
        "label": "Capture enabled",
        "description": "Take a screenshot every period seconds.",
        "defaultValue": true
      },
      {
        "key": "periodSec",
        "type": "integer",
        "label": "Every (seconds)",
        "description": "Seconds between captures.",
        "min": 5,
        "max": 86400,
        "defaultValue": 60
      },
      {
        "key": "dir",
        "type": "string",
        "label": "Save directory",
        "description": "~ expands to the home directory.",
        "defaultValue": "~/Pictures/screenlogs"
      },
      {
        "key": "monitors",
        "type": "list",
        "label": "Monitors",
        "description": "Monitor names to capture; empty captures every screen.",
        "defaultValue": []
      },
      {
        "key": "pauseWhenLocked",
        "type": "boolean",
        "label": "Pause while locked",
        "description": "Skip captures while the session is locked.",
        "defaultValue": true
      },
      {
        "key": "activeFrom",
        "type": "string",
        "label": "Active from (HH:MM)",
        "description": "Empty means always active.",
        "defaultValue": ""
      },
      {
        "key": "activeTo",
        "type": "string",
        "label": "Active to (HH:MM)",
        "description": "A start later than the end wraps past midnight.",
        "defaultValue": ""
      },
      {
        "key": "idleMinutes",
        "type": "integer",
        "label": "Pause after idle (minutes)",
        "description": "0 never pauses for idleness.",
        "min": 0,
        "max": 1440,
        "defaultValue": 0
      },
      {
        "key": "format",
        "type": "string",
        "label": "Image format",
        "description": "png or jpeg.",
        "defaultValue": "png"
      },
      {
        "key": "jpegQuality",
        "type": "integer",
        "label": "JPEG quality",
        "description": "Only used for jpeg.",
        "min": 1,
        "max": 100,
        "defaultValue": 85
      },
      {
        "key": "keep",
        "type": "integer",
        "label": "Recent screenshots to keep",
        "description": "Newest N files kept in the directory; 0 keeps everything.",
        "min": 0,
        "max": 100000,
        "defaultValue": 500
      },
      {
        "key": "keepHours",
        "type": "integer",
        "label": "Keep screenshots newer than (hours)",
        "description": "0 turns the age limit off.",
        "min": 0,
        "max": 87600,
        "defaultValue": 0
      },
      {
        "key": "maxDiskMb",
        "type": "integer",
        "label": "directory budget (MB)",
        "description": "Oldest files are deleted until the directory fits; 0 is unlimited.",
        "min": 0,
        "max": 1048576,
        "defaultValue": 0
      }
    ]
  }
}
